{
  "name": "廢棄代碼搜尋",
  "description": "搜尋廢棄的API和過時的代碼",
  "patterns": [
    "@deprecated",
    "DEPRECATED",
    "componentWillMount",
    "componentWillReceiveProps", 
    "componentWillUpdate",
    "findDOMNode",
    "ReactDOM\\.render",
    "UNSAFE_",
    "var\\s+\\w+",
    "function\\s*\\(",
    "require\\s*\\("
  ],
  "globs": ["**/*.{ts,tsx,js,jsx}"],
  "head_limit": 20,
  "context_lines": 2,
  "case_insensitive": true
}
