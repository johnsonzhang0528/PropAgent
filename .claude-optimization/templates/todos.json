{
  "name": "TODO和註釋搜尋",
  "description": "搜尋代碼中的TODO、FIXME、HACK等註釋",
  "patterns": [
    "TODO[:\\s]",
    "FIXME[:\\s]", 
    "HACK[:\\s]",
    "BUG[:\\s]",
    "NOTE[:\\s]",
    "WARNING[:\\s]",
    "@deprecated",
    "eslint-disable"
  ],
  "globs": ["**/*.{ts,tsx,js,jsx,md}"],
  "head_limit": 50,
  "context_lines": 2,
  "case_insensitive": true
}
