      },
      "firefox": {
        "enabled": true,
        "viewports": [
          { "width": 1200, "height": 800 }
        ]
      },
      "webkit": {
        "enabled": true,
        "viewports": [
          { "width": 1200, "height": 800 }
        ]
      }
    },
    "screenshotNaming": {
      "pattern": "{testName}-{viewport}-{browser}.png",
      "includeDate": false,
      "includeBrowser": false
    },
    "reportSettings": {
      "outputPath": "playwright-report",
      "includeTrace": true,
      "includeVideo": "retain-on-failure",
      "includeScreenshots": "only-on-failure"
    }
